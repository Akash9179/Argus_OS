-static void processLine(char* line) {
-    while (*line == ' ') line++;
-
-    char* end = nullptr;
-    if (line[0] == '0' && (line[1] == 'x' || line[1] == 'X')) line += 2;
-
-    uint8_t cmd = (uint8_t)strtoul(line, &end, 16);
-    if (end == line) {
-        serialReply(0x00, "ERR", "BAD_FORMAT");
-        return;
-    }
-
-    dispatch(cmd, end);
-}
-
-void serialPoll() {
-    while (Serial.available()) {
-        char c = (char)Serial.read();
-
-        if (c == '\n' || c == '\r') {
-            if (cmdLen > 0) {
-                cmdBuf[cmdLen] = '\0';
-                processLine(cmdBuf);
-                cmdLen = 0;
-            }
-        } else if (cmdLen < CMD_BUF_SIZE - 1) {
-            cmdBuf[cmdLen++] = c;
-        }
-    }
-}
+#include "serial_protocol.h"
+#include "config.h"
+#include "pwm_output.h"
+#include "feedback.h"
+#include "actuators.h"
+#include "ev_config.h"
+#include "lights.h"
+#include "indicators.h"
+#include "horn.h"
+#include "wifi_setup.h"
+#include "angle_limits.h"
+#include "steer_center.h"
+#include "watchdog.h"
+
+#define CMD_BUF_SIZE 128
+
+static char cmdBuf[CMD_BUF_SIZE];
+static uint8_t cmdLen = 0;
+static bool cmdDiscard = false;   // 4.1.5: an overlong line is dropped to its end
+
+void serialReply(uint8_t cmd, const char* status, const char* data) {
+    // 4.1.6: a reply no longer feeds the watchdog. Only the motion commands
+    // (0x05, 0x06, 0x12, 0x13, 0x14) and the explicit keepalive (0x15) call
+    // wdNoteAccepted(), each after its own OK; polls (0x01, 0x03, 0x04,
+    // 0x16, limits) answer and refresh nothing. In 4.1.5 every OK counted,
+    // so a host whose command path had died but whose poller lived kept a
+    // steering or brake move alive. 0x02 (this module's own PWM, believed
+    // unwired) is outside the watchdog and does not refresh it either.
+    Serial.printf("0x%02X;%s;%s\n", cmd, status, data);
+}
+
+// The OK reply of a motion command: the one kind of reply that refreshes
+// the silence watchdog (4.1.6).
+static void replyMotion(uint8_t cmd, uint8_t dir) {
+    char d[3];
+    snprintf(d, sizeof(d), "%02X", dir);
+    serialReply(cmd, "OK", d);
+    wdNoteAccepted();
+}
+
+static void cmdInfo(uint8_t cmd, const char*) {
+    char ver[7];
+    snprintf(ver, sizeof(ver), "%02X%02X%02X",
+             FW_VERSION_MAJOR, FW_VERSION_MINOR, FW_VERSION_PATCH);
+    serialReply(cmd, "OK", ver);
+}
+
+static void cmdAccel(uint8_t cmd, const char* args) {
+    if (actBrakeState() != 0) {
+        serialReply(cmd, "ERR", "BRAKE_ACTIVE");
+        return;
+    }
+
+    while (*args == ' ') args++;
+
+    char* end = nullptr;
+    unsigned long accel = strtoul(args, &end, 16);
+    if (end == args) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+
+    pwmSetAccel((float)accel);
+
+    char d[3];
+    snprintf(d, sizeof(d), "%02X", (uint8_t)(pwmDuty() + 0.5f));
+    serialReply(cmd, "OK", d);
+}
+
+static void cmdBrake(uint8_t cmd, const char*) {
+    if (!brakeValid()) {
+        serialReply(cmd, "ERR", "NO_SIGNAL");
+        return;
+    }
+    char d[5];
+    snprintf(d, sizeof(d), "%04X", brakeValue());
+    serialReply(cmd, "OK", d);
+}
+
+static void cmdSteer(uint8_t cmd, const char*) {
+    if (!steerValid()) {
+        serialReply(cmd, "ERR", "NO_SIGNAL");
+        return;
+    }
+    char d[5];
+    snprintf(d, sizeof(d), "%04X", steerValue());
+    serialReply(cmd, "OK", d);
+}
+
+static bool parseHex(const char* args, uint8_t& out) {
+    while (*args == ' ') args++;
+    char* end = nullptr;
+    unsigned long v = strtoul(args, &end, 16);
+    if (end == args || v > 0xFF) return false;
+    while (*end == ' ') end++;
+    if (*end != '\0') return false;   // 4.1.5: trailing text is not an argument
+    out = (uint8_t)v;
+    return true;
+}
+
+static void replyDir(uint8_t cmd, uint8_t dir) {
+    char d[3];
+    snprintf(d, sizeof(d), "%02X", dir);
+    serialReply(cmd, "OK", d);
+}
+
+static void cmdSteerSw(uint8_t cmd, const char* args) {
+    uint8_t dir;
+    if (!parseHex(args, dir) || dir > 2) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    if (dir == 0) wdClear();
+    else if (!wdMoveAllowed()) { serialReply(cmd, "ERR", "WD_TRIPPED"); return; }
+    ctrCancel();
+    limitsSteerBypass(false);
+    const char* why = limitsBlockReason(dir);
+    if (why) {
+        actSetSteer(0);
+        serialReply(cmd, "ERR", why);
+        return;
+    }
+    actSetSteer(dir);
+    replyMotion(cmd, actSteerState());
+}
+
+static void cmdSteerAdm(uint8_t cmd, const char* args) {
+    uint8_t dir;
+    if (!parseHex(args, dir) || dir > 2) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    if (dir == 0) wdClear();
+    else if (!wdMoveAllowed()) { serialReply(cmd, "ERR", "WD_TRIPPED"); return; }
+    ctrCancel();
+    limitsSteerBypass(true);
+    actSetSteer(dir);
+    replyMotion(cmd, actSteerState());
+}
+
+static void cmdBrakeAdm(uint8_t cmd, const char* args) {
+    uint8_t dir;
+    if (!parseHex(args, dir) || dir > 2) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    if (dir == 0) wdClear();
+    else if (!wdMoveAllowed()) { serialReply(cmd, "ERR", "WD_TRIPPED"); return; }
+    limitsBrakeBypass(true);
+    actSetBrake(dir);
+    if (dir != 0) pwmOff();
+    replyMotion(cmd, actBrakeState());
+}
+
+static void cmdSteerCtr(uint8_t cmd, const char* args) {
+    while (*args == ' ') args++;
+
+    if (*args != '\0') {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    if (!wdMoveAllowed()) {
+        serialReply(cmd, "ERR", "WD_TRIPPED");
+        return;
+    }
+    if (ctrActive()) {
+        serialReply(cmd, "ERR", "BUSY");
+        return;
+    }
+    if (!steerValid()) {
+        serialReply(cmd, "ERR", "NO_SIGNAL");
+        return;
+    }
+    limitsSteerBypass(false);
+    ctrStart();
+    serialReply(cmd, "OK", "01");
+    wdNoteAccepted();                 // 4.1.6: a motion command
+}
+
+// 0x15 KEEPALIVE (4.1.6): the explicit refresh of the silence watchdog,
+// for a host that has an actuator on and nothing new to command. No
+// argument. Answers the trip count, the same number STATUS reports as WD.
+// While tripped it answers too, and refreshes nothing that moves: only an
+// explicit stop (0x05 00, 0x06 00) clears the trip.
+static void cmdKeepalive(uint8_t cmd, const char* args) {
+    while (*args == ' ') args++;
+    if (*args != '\0') {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    char d[3];
+    snprintf(d, sizeof(d), "%02X", wdTimeouts());
+    serialReply(cmd, "OK", d);
+    wdNoteAccepted();
+}
+
+static void cmdBrakeSw(uint8_t cmd, const char* args) {
+    uint8_t dir;
+    if (!parseHex(args, dir) || dir > 2) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    if (dir == 0) wdClear();
+    else if (!wdMoveAllowed()) { serialReply(cmd, "ERR", "WD_TRIPPED"); return; }
+    limitsBrakeBypass(false);
+    const char* why = limitsBrakeBlockReason(dir);
+    if (why) {
+        actSetBrake(0);
+        serialReply(cmd, "ERR", why);
+        return;
+    }
+    actSetBrake(dir);
+    if (dir != 0) pwmOff();
+    replyMotion(cmd, actBrakeState());
+}
+
+static void cmdSpeed(uint8_t cmd, const char* args) {
+    uint8_t v;
+    if (!parseHex(args, v) || v < 1 || v > 3) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    evSetSpeed(v);
+    replyDir(cmd, evSpeed());
+}
+
+static void cmdGear(uint8_t cmd, const char* args) {
+    uint8_t v;
+    if (!parseHex(args, v) || v < 1 || v > 3) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    evSetGear(v);
+    replyDir(cmd, evGear());
+}
+
+static void cmdLight(uint8_t cmd, const char* args) {
+    uint8_t v;
+    if (!parseHex(args, v) || v > LIGHT_LOW) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    lightSetMode(v);
+    replyDir(cmd, lightMode());
+}
+
+static void cmdInd(uint8_t cmd, const char* args) {
+    uint8_t v;
+    while (*args == ' ') args++;
+    if (*args == '\0') {
+        replyDir(cmd, indMode());
+        return;
+    }
+    if (!parseHex(args, v) || v > IND_BOTH) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    indSet(v);
+    replyDir(cmd, indMode());
+}
+
+static void cmdHorn(uint8_t cmd, const char* args) {
+    uint8_t v;
+    if (!parseHex(args, v) || v < 1 || v > 3) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+#if HORN_LONG_LOCKED
+    if (v > 1) {
+        serialReply(cmd, "ERR", "LOCKED");
+        return;
+    }
+#endif
+    hornStart(v);
+    replyDir(cmd, v);
+}
+
+static void cmdStatus(uint8_t cmd, const char* args) {
+    while (*args == ' ') args++;
+    if (*args != '\0') {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    char d[80];
+    snprintf(d, sizeof(d),
+             "A=%02X,ST=%02X,BR=%02X,SP=%02X,GR=%02X,LI=%02X,IN=%02X,HO=%02X,WI=%02X,CT=%02X,WD=%02X",
+             (uint8_t)(pwmDuty() + 0.5f),
+             actSteerState(),
+             actBrakeState(),
+             evSpeed(),
+             evGear(),
+             lightMode(),
+             indMode(),
+             hornActive() ? 1 : 0,
+             wifiMode(),
+             ctrActive() ? 1 : 0,
+             wdTimeouts());
+    serialReply(cmd, "OK", d);
+}
+
+static void cmdReset(uint8_t cmd, const char*) {
+    serialReply(cmd, "OK", "01");
+    Serial.flush();
+    delay(50);
+    ESP.restart();
+}
+
+static bool wifiCmdLocked() {
+#if WIFI_CMD_LOCKED
+    return true;
+#else
+    return false;
+#endif
+}
+
+static void cmdWifiSet(uint8_t cmd, const char* args) {
+    if (wifiCmdLocked()) {
+        serialReply(cmd, "ERR", "LOCKED");
+        return;
+    }
+
+    while (*args == ' ') args++;
+
+    const char* sp = strchr(args, ' ');
+    if (sp == nullptr) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+
+    char newSsid[33];
+    char newPass[65];
+    size_t slen = (size_t)(sp - args);
+    if (slen >= sizeof(newSsid)) slen = sizeof(newSsid) - 1;
+    memcpy(newSsid, args, slen);
+    newSsid[slen] = '\0';
+
+    const char* p = sp;
+    while (*p == ' ') p++;
+    strncpy(newPass, p, sizeof(newPass) - 1);
+    newPass[sizeof(newPass) - 1] = '\0';
+
+    if (!wifiSetCredentials(newSsid, newPass)) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    serialReply(cmd, "OK", "01");
+}
+
+static void cmdWifi(uint8_t cmd, const char* args) {
+    if (wifiCmdLocked()) {
+        serialReply(cmd, "ERR", "LOCKED");
+        return;
+    }
+
+    uint8_t v;
+    if (!parseHex(args, v) || v > MODE_WIFI_AP) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    wifiSetMode(v);
+    replyDir(cmd, wifiMode());
+}
+
+static void cmdLim(uint8_t cmd, const char* args, bool brake) {
+    uint16_t minV, maxV;
+    if (brake) limitsGetBrake(minV, maxV);
+    else       limitsGetSteer(minV, maxV);
+
+    while (*args == ' ') args++;
+
+    if (*args != '\0') {
+        char* end = nullptr;
+        unsigned long a = strtoul(args, &end, 16);
+        if (end == args || a > 0xFFFFUL) {
+            serialReply(cmd, "ERR", "BAD_ARG");
+            return;
+        }
+        while (*end == ' ') end++;
+
+        const char* p2 = end;
+        unsigned long b = strtoul(p2, &end, 16);
+        if (end == p2 || b > 0xFFFFUL) {
+            serialReply(cmd, "ERR", "BAD_ARG");
+            return;
+        }
+        while (*end == ' ') end++;
+        if (*end != '\0') {
+            serialReply(cmd, "ERR", "BAD_ARG");
+            return;
+        }
+
+        bool ok = brake ? limitsSetBrake((uint16_t)a, (uint16_t)b)
+                        : limitsSetSteer((uint16_t)a, (uint16_t)b);
+        if (!ok) {
+            serialReply(cmd, "ERR", "BAD_RANGE");
+            return;
+        }
+        minV = (uint16_t)a;
+        maxV = (uint16_t)b;
+    }
+
+    char d[9];
+    snprintf(d, sizeof(d), "%04X%04X", minV, maxV);
+    serialReply(cmd, "OK", d);
+}
+
+static void cmdBrakeLim(uint8_t cmd, const char* args) {
+    cmdLim(cmd, args, true);
+}
+
+static void cmdSteerLim(uint8_t cmd, const char* args) {
+    cmdLim(cmd, args, false);
+}
+
+static void cmdLimEn(uint8_t cmd, const char* args) {
+    while (*args == ' ') args++;
+    if (*args == '\0') {
+        serialReply(cmd, "OK", limitsEnabled() ? "01" : "00");
+        return;
+    }
+#if LIMIT_EN_CMD_LOCKED
+    serialReply(cmd, "ERR", "LOCKED");
+#else
+    uint8_t v;
+    if (!parseHex(args, v) || v > 1) {
+        serialReply(cmd, "ERR", "BAD_ARG");
+        return;
+    }
+    limitsSetEnabled(v != 0);
+    serialReply(cmd, "OK", v ? "01" : "00");
+#endif
+}
+
+static void dispatch(uint8_t cmd, const char* args) {
+    switch (cmd) {
+        case 0x01: cmdInfo(cmd, args);  break;
+        case 0x02: cmdAccel(cmd, args); break;
+        case 0x03: cmdBrake(cmd, args); break;
+        case 0x04: cmdSteer(cmd, args); break;
+        case 0x05: cmdSteerSw(cmd, args); break;
+        case 0x06: cmdBrakeSw(cmd, args); break;
+        case 0x07: cmdSpeed(cmd, args); break;
+        case 0x08: cmdGear(cmd, args);  break;
+        case 0x09: cmdLight(cmd, args); break;
+        case 0x0A: cmdInd(cmd, args);   break;
+        case 0x0B: cmdHorn(cmd, args);  break;
+        case 0x0C: cmdReset(cmd, args); break;
+        case 0x0D: cmdWifiSet(cmd, args); break;
+        case 0x0E: cmdWifi(cmd, args);  break;
+        case 0x0F: cmdBrakeLim(cmd, args); break;
+        case 0x10: cmdSteerLim(cmd, args); break;
+        case 0x11: cmdLimEn(cmd, args);    break;
+        case 0x12: cmdSteerAdm(cmd, args); break;
+        case 0x13: cmdBrakeAdm(cmd, args); break;
+        case 0x14: cmdSteerCtr(cmd, args); break;
+        case 0x15: cmdKeepalive(cmd, args); break;
+        case 0x16: cmdStatus(cmd, args);   break;
+
+        default:
+            serialReply(cmd, "ERR", "UNKNOWN_COMMAND");
+            break;
+    }
+}
+
+static void processLine(char* line) {
+    while (*line == ' ') line++;
+
+    char* end = nullptr;
+    if (line[0] == '0' && (line[1] == 'x' || line[1] == 'X')) line += 2;
+
+    unsigned long op = strtoul(line, &end, 16);
+    if (end == line || op > 0xFF || (*end != '\0' && *end != ' ')) {
+        serialReply(0x00, "ERR", "BAD_FORMAT");   // 4.1.5: a whole opcode, nothing glued to it
+        return;
+    }
+    uint8_t cmd = (uint8_t)op;
+
+    dispatch(cmd, end);
+}
+
+void serialPoll() {
+    uint8_t budget = 32;                      // 4.1.5: bounded work per pass
+    while (budget-- && Serial.available()) {
+        char c = (char)Serial.read();
+
+        if (c == '\n' || c == '\r') {
+            bool ready = !cmdDiscard && cmdLen > 0;
+            cmdBuf[cmdLen] = '\0';
+            cmdLen = 0;
+            cmdDiscard = false;
+            if (ready) {
+                processLine(cmdBuf);
+                return;                       // one line per pass; the watchdog runs between lines
+            }
+        } else if (cmdDiscard) {
+            continue;
+        } else if ((unsigned char)c < 0x20 || (unsigned char)c > 0x7E || cmdLen >= CMD_BUF_SIZE - 1) {
+            cmdDiscard = true;                // control byte or overlong: drop the whole line
+            cmdLen = 0;
+        } else {
+            cmdBuf[cmdLen++] = c;
+        }
+    }
+}
diff -ruN a/src/watchdog.cpp b/src/watchdog.cpp
--- a/src/watchdog.cpp	1970-01-01 05:30:00
+++ b/src/watchdog.cpp	2026-11-05 15:24:26
@@ -0,0 +1,92 @@
+#include "watchdog.h"
+#include "config.h"
+#include "actuators.h"
+#include "feedback.h"
+#include "steer_center.h"
+#include <Arduino.h>
+
+// Same levels as actuators.cpp; the pins come from config.h.
+#define WD_RELAY_OFF HIGH
+
+static uint32_t lastAcceptedMs = 0;
+static uint32_t steerNoSignalSince = 0;
+static uint32_t brakeNoSignalSince = 0;
+static uint16_t lastSteer = 0;
+static uint16_t lastBrake = 0;
+static bool haveLastSteer = false;
+static bool haveLastBrake = false;
+static uint8_t timeouts = 0;
+static bool tripped = false;
+
+static void allOff(const char* why) {
+    // every relay off in the same instant, no break-before-make delay
+    digitalWrite(STEER_LEFT_PIN, WD_RELAY_OFF);
+    digitalWrite(STEER_RIGHT_PIN, WD_RELAY_OFF);
+    digitalWrite(BRAKE_FWD_PIN, WD_RELAY_OFF);
+    digitalWrite(BRAKE_REV_PIN, WD_RELAY_OFF);
+    ctrCancel();
+    actSetSteer(0);     // keeps the actuator state honest; pins are already off
+    actSetBrake(0);
+    tripped = true;
+    if (timeouts < 0xFF) timeouts++;
+    Serial.printf("0x00;WD;%s\n", why);
+}
+
+static uint16_t absDiff(uint16_t a, uint16_t b) { return a > b ? a - b : b - a; }
+
+// A sensor is trusted while an actuator is on only if it answers and its
+// reading moves plausibly: a jump larger than WD_MAX_STEP between samples
+// is treated as no signal for that loop (the horn produces exactly that).
+// Known gap, left as is in 4.1.6: the jump forgets the last good sample,
+// so the next valid-looking sample, cached or fresh, is trusted again;
+// only a dropout longer than WD_NO_SIGNAL_MS trips.
+static bool sensorBad(bool valid, uint16_t value, uint16_t& last, bool& haveLast, uint32_t& since, uint32_t now) {
+    if (!valid) {
+        haveLast = false;
+        if (since == 0) since = now;
+        return (uint32_t)(now - since) > WD_NO_SIGNAL_MS;
+    }
+    if (haveLast && absDiff(value, last) > WD_MAX_STEP) {
+        haveLast = false;               // implausible: do not trust until it settles
+        if (since == 0) since = now;
+        return (uint32_t)(now - since) > WD_NO_SIGNAL_MS;
+    }
+    last = value; haveLast = true; since = 0;
+    return false;
+}
+
+void wdNoteAccepted() {
+    lastAcceptedMs = millis();
+}
+
+void wdUpdate() {
+    uint32_t now = millis();
+    bool steerOn = actSteerState() != 0;
+    bool brakeOn = actBrakeState() != 0;
+    bool moving = steerOn || brakeOn || ctrActive();
+
+    if (steerOn || ctrActive()) {
+        if (sensorBad(steerValid(), steerValue(), lastSteer, haveLastSteer, steerNoSignalSince, now)) {
+            allOff("NO_SIGNAL"); steerNoSignalSince = 0; return;
+        }
+    } else {
+        steerNoSignalSince = 0; haveLastSteer = false;
+    }
+    if (brakeOn) {
+        if (sensorBad(brakeValid(), brakeValue(), lastBrake, haveLastBrake, brakeNoSignalSince, now)) {
+            allOff("NO_SIGNAL"); brakeNoSignalSince = 0; return;
+        }
+    } else {
+        brakeNoSignalSince = 0; haveLastBrake = false;
+    }
+
+    // silence: an accepted command within the window, or everything off
+    if (moving && !tripped && (uint32_t)(now - lastAcceptedMs) > WD_TIMEOUT_MS) {
+        allOff("TIMEOUT");
+    }
+}
+
+bool wdMoveAllowed() { return !tripped; }
+void wdClear() { tripped = false; lastAcceptedMs = millis(); }
+uint8_t wdTimeouts() { return timeouts; }
+bool wdTripped() { return tripped; }
diff -ruN a/src/watchdog.h b/src/watchdog.h
--- a/src/watchdog.h	1970-01-01 05:30:00
+++ b/src/watchdog.h	2026-11-05 15:24:26
@@ -0,0 +1,32 @@
+#pragma once
+#include <stdint.h>
+
+// Silence and feedback watchdog for the ARGUS DRIVE module, firmware
+// 4.1.6 (added by ARGUS on 14 Oct 2026 to Gulshan Shah's 4.1.4 as 4.1.5;
+// authority narrowed on 15 Oct 2026 as 4.1.6; see the patch beside this
+// file).
+//
+// Silence: while a steering or brake actuator is on, or centring is
+// running, the module must have accepted a motion command (0x05, 0x06,
+// 0x12, 0x13, 0x14, answered OK) or the explicit keepalive (0x15) within
+// WD_TIMEOUT_MS, or all four actuator relays are switched off at once,
+// centring is cancelled, "0x00;WD;TIMEOUT" is printed once and the trip
+// is latched. Polls (INFO, angles, STATUS, limits) answer and refresh
+// nothing: in 4.1.5 any accepted command counted, so a host whose
+// command path had died but whose poller lived kept a move alive. At
+// rest nothing is required.
+//
+// Feedback: while a steering actuator is on without a valid steering
+// reading for WD_NO_SIGNAL_MS (the horn causes exactly this), it is
+// switched off the same way with "0x00;WD;NO_SIGNAL"; the brake likewise.
+//
+// While tripped, every command that would energise an actuator
+// (0x05/0x06/0x12/0x13 with a direction, 0x14) is refused with
+// ERR;WD_TRIPPED. An explicit stop (0x05 00 or 0x06 00) clears the trip.
+// STATUS gains WD=<trip count, capped at FF>.
+void wdNoteAccepted();     // called after the OK reply of a motion command or 0x15, nothing else (4.1.6)
+void wdUpdate();           // call from loop(), before serial work
+bool wdMoveAllowed();      // false while tripped
+void wdClear();            // an explicit stop command clears the trip
+uint8_t wdTimeouts();      // for STATUS
+bool wdTripped();
