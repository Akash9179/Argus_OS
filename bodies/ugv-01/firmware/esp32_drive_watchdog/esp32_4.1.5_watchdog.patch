diff -ruN a/src/watchdog.cpp b/src/watchdog.cpp
--- a/src/watchdog.cpp	1969-12-31 19:00:00
+++ b/src/watchdog.cpp	2026-10-13 14:20:15
@@ -0,0 +1,64 @@
+#include "watchdog.h"
+#include "config.h"
+#include "actuators.h"
+#include "feedback.h"
+#include "steer_center.h"
+#include <Arduino.h>
+
+// Same levels as actuators.cpp; the pins come from config.h.
+#define WD_RELAY_OFF HIGH
+
+static uint32_t lastAcceptedMs = 0;
+static uint32_t steerNoSignalSince = 0;
+static uint32_t brakeNoSignalSince = 0;
+static uint8_t timeouts = 0;
+static bool tripped = false;
+
+static void allOff(const char* why) {
+    // every relay off in the same instant, no break-before-make delay
+    digitalWrite(STEER_LEFT_PIN, WD_RELAY_OFF);
+    digitalWrite(STEER_RIGHT_PIN, WD_RELAY_OFF);
+    digitalWrite(BRAKE_FWD_PIN, WD_RELAY_OFF);
+    digitalWrite(BRAKE_REV_PIN, WD_RELAY_OFF);
+    ctrCancel();
+    actSetSteer(0);     // keeps the actuator state honest; pins are already off
+    actSetBrake(0);
+    tripped = true;
+    if (timeouts < 0xFF) timeouts++;
+    Serial.printf("0x00;WD;%s\n", why);
+}
+
+void wdNoteAccepted() {
+    lastAcceptedMs = millis();
+}
+
+void wdUpdate() {
+    uint32_t now = millis();
+    bool steerOn = actSteerState() != 0;
+    bool brakeOn = actBrakeState() != 0;
+    bool moving = steerOn || brakeOn || ctrActive();
+
+    // feedback: no reading, no motion (the horn takes the sensor down)
+    if (steerOn && !steerValid()) {
+        if (steerNoSignalSince == 0) steerNoSignalSince = now;
+        else if ((uint32_t)(now - steerNoSignalSince) > WD_NO_SIGNAL_MS) { allOff("NO_SIGNAL"); steerNoSignalSince = 0; return; }
+    } else {
+        steerNoSignalSince = 0;
+    }
+    if (brakeOn && !brakeValid()) {
+        if (brakeNoSignalSince == 0) brakeNoSignalSince = now;
+        else if ((uint32_t)(now - brakeNoSignalSince) > WD_NO_SIGNAL_MS) { allOff("NO_SIGNAL"); brakeNoSignalSince = 0; return; }
+    } else {
+        brakeNoSignalSince = 0;
+    }
+
+    // silence: an accepted command within the window, or everything off
+    if (moving && !tripped && (uint32_t)(now - lastAcceptedMs) > WD_TIMEOUT_MS) {
+        allOff("TIMEOUT");
+    }
+}
+
+bool wdMoveAllowed() { return !tripped; }
+void wdClear() { tripped = false; lastAcceptedMs = millis(); }
+uint8_t wdTimeouts() { return timeouts; }
+bool wdTripped() { return tripped; }
diff -ruN a/src/watchdog.h b/src/watchdog.h
--- a/src/watchdog.h	1969-12-31 19:00:00
+++ b/src/watchdog.h	2026-10-13 14:20:02
@@ -0,0 +1,27 @@
+#pragma once
+#include <stdint.h>
+
+// Silence and feedback watchdog for the ARGUS DRIVE module, firmware
+// 4.1.5 (added by ARGUS on 14 Oct 2026 to Gulshan Shah's 4.1.4; see the
+// patch beside this file).
+//
+// Silence: while a steering or brake actuator is on, or centring is
+// running, the module must answer an accepted command (one it replied
+// OK to) within WD_TIMEOUT_MS, or all four actuator relays are switched
+// off at once, centring is cancelled, "0x00;WD;TIMEOUT" is printed once
+// and the trip is latched. At rest nothing is required.
+//
+// Feedback: while a steering actuator is on without a valid steering
+// reading for WD_NO_SIGNAL_MS (the horn causes exactly this), it is
+// switched off the same way with "0x00;WD;NO_SIGNAL"; the brake likewise.
+//
+// While tripped, every command that would energise an actuator
+// (0x05/0x06/0x12/0x13 with a direction, 0x14) is refused with
+// ERR;WD_TRIPPED. An explicit stop (0x05 00 or 0x06 00) clears the trip.
+// STATUS gains WD=<trip count, capped at FF>.
+void wdNoteAccepted();     // called by serialReply for every OK reply
+void wdUpdate();           // call from loop(), before serial work
+bool wdMoveAllowed();      // false while tripped
+void wdClear();            // an explicit stop command clears the trip
+uint8_t wdTimeouts();      // for STATUS
+bool wdTripped();
