===== tests_head
"""Unit tests for the ARGUS DRIVE v4.1.3 command encoder."""

import sys
from pathlib import Path

import pytest

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from serial_control.argus_protocol import (  # noqa: E402
    UnknownCommand, brake_angle_deg, brake_limits_deg, brake_percent,
    describe, encode, firmware_version, format_reply,
    parse_reply, relative_steer, steer_angle_deg, steer_limits_deg)


@pytest.mark.parametrize('token, frame', [
    # examples straight from section 4 of the spec, written as the
    # firmware actually accepts them: hex as ASCII text, LF-terminated
    ('INFO', b'0x01\n'),
    ('ACCEL:50', b'0x02 32\n'),
    ('READ:BRAKE', b'0x03\n'),
    ('READ:STEER', b'0x04\n'),
    ('STEER:L', b'0x05 01\n'),
    ('STEER:R', b'0x05 02\n'),
    ('STEER:STOP', b'0x05 00\n'),
    ('BRAKE:APPLY', b'0x06 01\n'),
    ('BRAKE:STOP', b'0x06 00\n'),
    ('BRAKE:RELEASE', b'0x06 02\n'),
    ('SPEED:2', b'0x07 02\n'),
    ('GEAR:D', b'0x08 01\n'),
    ('GEAR:N', b'0x08 02\n'),
    ('GEAR:R', b'0x08 03\n'),
    ('LIGHT:OFF', b'0x09 00\n'),
    ('LIGHT:RING', b'0x09 01\n'),
    ('LIGHT:HIGH', b'0x09 02\n'),
    ('LIGHT:LOW', b'0x09 03\n'),
    ('IND:OFF', b'0x0A 00\n'),
    ('IND:L', b'0x0A 01\n'),
    ('IND:R', b'0x0A 02\n'),
    ('IND:PARK', b'0x0A 03\n'),
    ('HORN', b'0x0B 01\n'),
    ('READ:BRKLIM', b'0x0F\n'),
    ('READ:STRLIM', b'0x10\n'),
    ('STEER:C', b'0x14\n'),
    ('STATUS', b'0x16\n'),
])
def test_tokens_encode_to_spec_frames(token, frame):
    assert encode(token) == [frame]


-- accel test
"""Unit tests for the accelerator board encoder and the drive/accel router."""

import sys
from pathlib import Path

import pytest

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from serial_control.accel_protocol import (  # noqa: E402
    INFO, ZERO, ThrottleLocked, duty_frame, firmware_version, route)
from serial_control.argus_protocol import UnknownCommand  # noqa: E402


# -- frames -------------------------------------------------------------------

def test_info_frame():
    assert INFO == b'0x01\n'


@pytest.mark.parametrize('pct, frame', [(0, b'0x02;00\n'), (10, b'0x02;0A\n'),
                                        (50, b'0x02;32\n'),
                                        (100, b'0x02;64\n')])
def test_duty_is_hex_text_after_a_semicolon(pct, frame):
    assert duty_frame(pct) == frame


def test_zero_is_duty_zero():
    assert ZERO == b'0x02;00\n'


@pytest.mark.parametrize('pct', [-1, 101])
def test_duty_out_of_range_is_refused(pct):
    with pytest.raises(ValueError):
        duty_frame(pct)


@pytest.mark.parametrize('data, version', [('AC0102', '1.2'),
                                           ('ac0110', '1.10')])
def test_firmware_version(data, version):
