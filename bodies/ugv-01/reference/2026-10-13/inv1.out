===== remote_bridge_py
151 /home/tessy_01/Desktop/Remote/bridge.py
#!/usr/bin/env python3
"""Serial <-> WebSocket bridge with a static file server, all on one port.

Python port of the Go bridge: reads lines from a serial port and fans them out
to every connected browser, writes anything a browser sends back to the serial
port, and serves ./public over plain HTTP on the same listener.

    python3 bridge.py --serial /dev/ttyUSB0 --baud 115200 --http 8080
"""

import argparse
import asyncio
import mimetypes
import os
import sys
import threading
from http import HTTPStatus

import serial
import websockets

clients = set()
loop = None
port = None
port_lock = threading.Lock()

STATIC_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "public")


# SERIAL -> BROWSER
def serial_reader():
    """Blocking read loop, runs on its own thread."""
    buf = bytearray()

    while True:
        try:
            chunk = port.read(port.in_waiting or 1)
        except serial.SerialException as err:
            print("Serial read error:", err, flush=True)
            return

        if not chunk:
            continue

        buf.extend(chunk)

        while b"\n" in buf:
            line, _, rest = buf.partition(b"\n")
            buf = bytearray(rest)

            msg = line.decode("utf-8", "replace").rstrip("\r")
            print("System:", msg, flush=True)

            # Hop back onto the event loop thread to touch the sockets.
            loop.call_soon_threadsafe(asyncio.create_task, broadcast(msg + "\n"))


async def broadcast(msg):
    for client in list(clients):
        try:
            await client.send(msg)
        except Exception:
            clients.discard(client)
            await client.close()


# BROWSER -> SERIAL
def serial_write(data):
    with port_lock:
        port.write(data)


async def ws_handler(websocket):
    clients.add(websocket)
    print("Browser connected:", websocket.remote_address, flush=True)

    try:
        async for msg in websocket:
            if isinstance(msg, bytes):
                msg = msg.decode("utf-8", "replace")

            msg = msg.rstrip("\r\n")  # client may already terminate the line
            print("Browser:", msg, flush=True)

            try:
                await asyncio.to_thread(serial_write, msg.encode() + b"\n")
            except Exception as err:
                print("Serial write error:", err, flush=True)
    except websockets.ConnectionClosed:
        pass
    finally:
        clients.discard(websocket)
        print("Browser disconnected", flush=True)


# Static files, served off the same port for anything that isn't the WS upgrade
def serve_static(path, request_headers):
    if "Upgrade" in request_headers:
        return None  # let the WebSocket handshake through

    url_path = path.split("?", 1)[0].split("#", 1)[0]
    if url_path.endswith("/"):
        url_path += "index.html"

    target = os.path.normpath(os.path.join(STATIC_DIR, url_path.lstrip("/")))
    if not target.startswith(STATIC_DIR) or not os.path.isfile(target):
        return HTTPStatus.NOT_FOUND, [], b"404 not found\n"

    with open(target, "rb") as fh:
        body = fh.read()

    ctype = mimetypes.guess_type(target)[0] or "application/octet-stream"
    headers = [("Content-Type", ctype), ("Content-Length", str(len(body)))]
    return HTTPStatus.OK, headers, body


async def main():
    global loop, port

    parser = argparse.ArgumentParser(description=__doc__)

