===== safe_area_node
FILE=src/zed_bringup/zed_bringup/safe_area.py
"""ROS 2 node "safe_area": where the vehicle can drive, for the console.

Fuses the ZED depth map, the IMU's sense of "up" and the object detector into
one operator view and one small status message:

  /<ns>/zed_node/depth/depth_registered  (32FC1)  --+
  /<ns>/zed_node/depth/camera_info                  |
  /<ns>/zed_node/rgb/color/rect/image    (bgra8)    +--> /<ns>/perception/safe_area (rgb8)
  /<ns>/zed_node/imu/data                           |    /<ns>/perception/safe_area/status (JSON)
  /<ns>/zed_node/obj_det/objects                    |    /web_server/camera/in -> /camera
  /<ns>/zed_node/odom                             --+

The image is the colour frame tinted by class - green drivable ground the
vehicle can reach, dim green ground it cannot see a straight path to, yellow
rough ground, red obstacles, purple drops - with the vehicle-width corridor
drawn on the ground and a bar where it is first blocked. It is published at
half the depth resolution, which keeps the depth's aspect ratio, so the
console's normalized detection boxes still line up on top of it.

The geometry lives in freespace.py (pure NumPy, unit tested); this file is
only ROS plumbing and drawing.

This is an operator aid, NOT a safety system. Nothing here stops the vehicle,
and single-camera stereo misses thin, transparent and very dark obstacles.

Like depth_colorizer, the depth and colour subscriptions exist only while
someone watches the image: depth_registered is ~2 MB a frame and holding the
subscription costs the wrapper publishing time even when nobody looks.
"""

import json
import math
from collections import deque

import numpy as np
import rclpy
from nav_msgs.msg import Odometry
from rclpy.node import Node
from sensor_msgs.msg import CameraInfo, Image, Imu
from std_msgs.msg import String
from zed_msgs.msg import ObjectsStamped

from zed_bringup import freespace as fs
from zed_bringup.depth_colorizer import decode_depth

STRIDE = 2
# RGB per class id; UNKNOWN is left untinted.
TINT = {
    fs.GROUND: (40, 120, 60),       # ground, but not reachable straight on
    fs.ROUGH: (240, 200, 40),
    fs.OBSTACLE: (235, 60, 50),
    fs.DROP: (170, 70, 230),
}
REACHABLE = (40, 225, 90)
STATUS_RGB = {'CLEAR': (40, 225, 90), 'CAUTION': (245, 170, 30),
              'STOP': (235, 60, 50)}
ALPHA = 0.45


def draw_polyline(img, us, vs, color, thickness=2):

===== detection_bridge_doc
"""ROS 2 node "detection_bridge": ZED object detections for the browser.

The video itself goes to the browser as MJPEG from web_video_server. This node
carries only the boxes, as JSON on the existing authenticated WebSocket:

  /zed/zed_node/obj_det/objects (zed_msgs/ObjectsStamped)
      -> /web_server/camera/in (std_msgs/String)  -> /camera namespace

Boxes are emitted in **normalized** [0,1] coordinates. The SDK reports pixels in
the *grab* resolution, but the browser sees whatever size web_video_server (and
CSS) settled on, so raw pixels would misalign on every layout. Normalized boxes
scale to any display size without the browser knowing the capture resolution.

The divisor is the grab resolution, which is NOT always what camera_info
reports. With `pub_resolution: CUSTOM` and `pub_downscale_factor: 2.0` (see
config/dual_playback.yaml) the wrapper publishes - and describes in
camera_info - a half-size image while object detection still runs on the full
grab frame. Dividing by the published size then makes every coordinate exactly
`pub_downscale_factor` times too large: boxes drift down and to the right, and a
feed whose objects sit right of centre pushes them off-screen entirely, which
looks like detection is broken rather than misplaced. So the factor is read
back from the ZED node itself instead of being assumed.

One instance runs per camera, so every message carries a `camera` field naming
the feed it belongs to. The console keys its overlays on that field rather than
assuming a single source: two bridges publish to the same topic at their own
rates, and a stalled camera stops updating only its own overlay.

Detections arrive at the grab rate (up to 30 Hz). That is more than an operator
view needs and it shares the socket with /cmd, so publishing is rate-limited.
"""

import json

import rclpy
from rcl_interfaces.srv import GetParameters
from rclpy.node import Node
from sensor_msgs.msg import CameraInfo
from std_msgs.msg import String
from zed_msgs.msg import ObjectsStamped

===== phone_gps
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument
from launch.substitutions import LaunchConfiguration
from launch_ros.actions import Node


def generate_launch_description():
    return LaunchDescription([
        DeclareLaunchArgument(
            'frame_id', default_value='gps',
            description='frame_id stamped on the published NavSatFix.'),
        Node(
            package='phone_gps',
            executable='gps',
            name='gps',
            output='screen',
            parameters=[{
                'frame_id': LaunchConfiguration('frame_id'),
            }],
        ),
    ])

===== commands_js
/*
 * Vehicle command vocabulary + telemetry parsing.
 *
 * These tokens are the console's side of the ARGUS DRIVE serial protocol
 * (firmware v4.1.3). `cmd_node` (serial_control) translates each one into
 * the firmware's hex-text frame ("0x05 01") in serial_control/argus_protocol.py — that
 * file is the source of truth; a token it doesn't know is dropped there.
 * Firmware constraints the UI has to respect:
 *  - ring / high / low share ONE light channel: selecting one turns the
 *    others off.
 *  - left / right indicators and parking share ONE channel too.
 *  - horn is a fixed 0.5 s pulse (longer pulses are locked in firmware).
 *  - brake is an actuator (apply / stop / release), not a level, and while
 *    braking the firmware rejects throttle.
 */

export const CMD = {
  // stop = halt the actuator where it is; center = firmware auto-centre
  steer: { left: 'STEER:L', right: 'STEER:R', stop: 'STEER:STOP', center: 'STEER:C' },
  light: { ring: 'LIGHT:RING', high: 'LIGHT:HIGH', low: 'LIGHT:LOW', off: 'LIGHT:OFF' },
  horn: 'HORN',
  indicator: { left: 'IND:L', right: 'IND:R', park: 'IND:PARK', off: 'IND:OFF' },
  gear: { D: 'GEAR:D', R: 'GEAR:R', N: 'GEAR:N' },
  // no firmware equivalent — consumed by the autonomy layer, not the MCU
  mode: { manual: 'MODE:MANUAL', auto: 'MODE:AUTO' },
  speed: { 1: 'SPEED:1', 2: 'SPEED:2', 3: 'SPEED:3' },
  brake: { apply: 'BRAKE:APPLY', stop: 'BRAKE:STOP', release: 'BRAKE:RELEASE' },
  accel: (pct) => `ACCEL:${Math.round(pct)}`,   // 0..100 %, duty clamped to 20-90% by firmware
  estop: 'ESTOP',

  // Autonomy waypoints — PLACEHOLDER tokens. There is no waypoint/route
  // protocol in the firmware yet; these are what the Autonomy tab emits so
  // there's a single spot to swap in the real protocol when it exists. The
  // Go button sends start, end, MODE:AUTO, then NAV:GO; Stop sends
  // NAV:ABORT then MODE:MANUAL.
  nav: {
    start: (lat, lon) => `NAV:START:${lat.toFixed(6)},${lon.toFixed(6)}`,
    end: (lat, lon) => `NAV:END:${lat.toFixed(6)},${lon.toFixed(6)}`,
    go: 'NAV:GO',
    abort: 'NAV:ABORT',
  },

  // Autonomy drive settings — PLACEHOLDER tokens (Autonomy tab's Drive
  // settings card). Emitted whenever a setting changes.
  auto: {
    maxSpeed: (kmph) => `AUTO:MAXSPEED:${kmph}`,  // km/h cap
    roadDetect: (on) => `AUTO:ROADDET:${on ? 'ON' : 'OFF'}`,
    objClass: (on) => `AUTO:OBJCLS:${on ? 'ON' : 'OFF'}`,
  },
};

/*
 * Heading + steer angle have no dedicated telemetry namespace yet — the
 * vehicle would report them as serial lines echoed on /cmd/in. Parse a
 * lenient `key=value` / `key:value` form so several firmware shapes work,
 * e.g. "TELEM heading=92 steer=-4.5" or "hdg:92,steering:-4". Returns null
 * when a line carries no telemetry we recognise, so ordinary /cmd chatter
 * is left alone.
 */
export function parseTelemetry(line) {
  if (typeof line !== 'string') return null;
  const out = {};
  const heading = /(?:heading|hdg)\s*[:=]\s*(-?\d+(?:\.\d+)?)/i.exec(line);
  const steer = /(?:steer(?:ing)?|angle)\s*[:=]\s*(-?\d+(?:\.\d+)?)/i.exec(line);
  // No lat/lon here: vehicle position comes from /gps (the phone page) and
  // has exactly one source. A stray "lat=" in a firmware line must not get
  // to fight the phone over the same map marker.
  if (heading) out.heading = parseFloat(heading[1]);
  if (steer) out.steer = parseFloat(steer[1]);
  // "TELEM brake=42 brakedeg=111.1": travel % between the brake limits, and
  // the actuator angle. brake= is absent until the limits are known.
  const brake = /\bbrake\s*[:=]\s*(-?\d+(?:\.\d+)?)/i.exec(line);
  const brakeDeg = /\bbrakedeg\s*[:=]\s*(-?\d+(?:\.\d+)?)/i.exec(line);
  if (brake) out.brake = parseFloat(brake[1]);
  if (brakeDeg) out.brakeDeg = parseFloat(brakeDeg[1]);
  return Object.keys(out).length ? out : null;
}

